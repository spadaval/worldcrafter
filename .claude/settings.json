{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "atelier status --hook claude # atelier-managed:SessionStart",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "atelier land --hook claude # atelier-managed:Stop",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  }
}
